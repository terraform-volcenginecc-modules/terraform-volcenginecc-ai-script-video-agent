# Docker Compose defaults to localhost:8080.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
COOKIE_SECURE=false
POLL_SECONDS=10
# For ECS delivery set immutable, published image references here.
# BACKEND_IMAGE=your-registry/animation-backend@sha256:...
# WEB_IMAGE=your-registry/animation-web@sha256:...
# Set COOKIE_SECURE=true when a HTTPS reverse proxy is configured.
# Adjust only to the actual trusted model-result domain returned by your account.
MEDIA_ALLOWED_HOSTS=.volces.com,.volcengine.com,.bytecdn.cn,.ibytedtos.com
